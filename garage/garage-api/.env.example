# Garage-API - Environment Variables (Template).
# Kopieren nach .env und Werte eintragen. .env ist gitignored und enthaelt
# NIEMALS echte Secrets im Repository.

# PostgreSQL-Verbindung (Pflicht)
DATABASE_URL="postgresql://garage:garage@localhost:5432/garage?schema=public"

# HTTP-Port (optional, Default 4100)
PORT=4100
NODE_ENV=development

# Auth (Pflicht in Produktion)
# JWT_SECRET: min. 32 Zeichen, zufaellig. Erzeugen z. B. mit:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="CHANGE-ME-min-32-chars-random-hex-string"
# Access-Token-Laufzeit in Sekunden (Default 3600 = 1 h)
JWT_EXPIRES_IN_SECONDS=3600

# Bootstrap-Admin (nur fuer den SEED relevant - legt den ersten Admin an,
# falls kein Admin existiert). Nach dem ersten Start Passwort aendern oder
# Konto loeschen.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="CHANGE-ME"
ADMIN_DISPLAY_NAME="Garage Admin"

# CORS: kommaseparierte Urspruenge, die die API aufrufen duerfen.
# "*" = alle (nur Entwicklung). Spaeter hier die MotoRoute-App/Backend-
# Herkunft eintragen (z. B. https://motoroute-api.onrender.com).
CORS_ORIGINS="*"
