[TEMPLATE]
# Copy to .env and fill in real values. .env is gitignored.
# This file documents which environment variables exist - it never
# contains real secrets (see Phase 1/2, Abschnitt 16: keine hartcodierten
# API-Keys). Jeder Wert hier ist ein PLATZHALTER.

PORT=3000
NODE_ENV=development

# Registrierung ohne E-Mail-Bestätigung (private Testphase): neue
# Konten sind sofort bestätigt und können sich direkt einloggen.
# "false" oder unset = normale Supabase-E-Mail-Verifikation.
AUTH_AUTO_CONFIRM=true

# Internal GraphHopper instance - never publicly reachable, see
# graphhopper/config.yml (bind_host 127.0.0.1).
# OPTIONAL: unset = Routing läuft über den OSRM-Fallback
# (ROUTING_FALLBACK_URL, Default: https://router.project-osrm.org,
# Auto-Profil, Kurven-/Vermeidungs-Präferenzen entfallen dort).
# ROUTING_FALLBACK_URL=https://router.project-osrm.org
GRAPHHOPPER_URL=http://127.0.0.1:8989

# Supabase project (Postgres + PostGIS + Auth)
SUPABASE_URL=https://your-project.supabase.co
# Anonymous-Key des Projekts (GoTrue-Login aus der App) - NICHT der Service-Role-Key.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=dein_supabase_service_role_key
# Wird von keinem Modul mehr gelesen (JWT-Verifikation serverseitig
# über auth.getUser()) - darf leer bleiben.
SUPABASE_JWT_SECRET=

# Overpass API for OSM-based POIs (fuel stations).
# Public endpoint is fine for MVP; set a self-hosted instance once
# rate limits become an issue.
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Geocoding (Photon/Nominatim self-hosted or provider - TBD per Phase 1/2 Teil H)
GEOCODING_URL=

# Traffic provider - TomTom Traffic API v5 (incidentDetails).
# The traffic module treats an unset key as "feature disabled": it then
# returns an empty incident list instead of failing. Get a key at
# developer.tomtom.com. Key NEVER goes into the app bundle; incident
# data is only cached transiently (60 s TTL, in-memory) per the
# TomTom license terms.
TRAFFIC_PROVIDER=tomtom
TRAFFIC_API_KEY=dein_tomtom_api_key

# Weather radar - OpenWeatherMap One Call API 3.0 (hourly forecast).
# OPTIONAL: ohne Key läuft das Wetter-Radar ab Werk über Open-Meteo
# (keyless). Der OWM-Key schaltet als Upgrade auf One Call 3.0 um.
# Key NEVER goes into the app bundle; forecast rows are cached
# transiently (10 min TTL, in-memory) only.
OPENWEATHER_API_KEY=

# Standalone biker POI service (motoroute_poi_service - TomTom-based daily
# scan with biker scores, runs with its OWN TomTom key + own Postgres).
# Unset = feature disabled (503); the app keeps working with OSM POIs.
BIKER_POI_SERVICE_URL=

# Ride-Relais (Live-Gruppenfahrt + Radar): Shared Secret zwischen BFF und
# POI-Dienst. NUR das BFF speist verifizierte Positions-Beats ein
# (Membership via Supabase-RLS geprüft). Muss IDENTISCH mit dem
# RIDE_RELAY_SECRET des POI-Dienstes sein; fehlt es dort, startet dessen
# Relais nicht (fail-closed).
RIDE_RELAY_SECRET=

# Public URL of the backend (used for OAuth email redirects, etc.)
# e.g. https://api.motoroute.app oder https://motoroute-api.onrender.com
PUBLIC_URL=
