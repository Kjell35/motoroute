# PostgreSQL-Verbindung (PostGIS erforderlich)
DATABASE_URL=postgresql://user:password@localhost:5432/motoroute

# REST-API-Port
PORT=3100

# TomTom Search API (nicht committen!)
TOMTOM_API_KEY=dein_tomtom_api_key

# Täglicher Welt-Scan (03:00 Uhr)
SCAN_CRON=0 3 * * *

# Rücksicht auf Rate-Limits und Kosten (siehe README)
SCAN_THROTTLE_MS=350
SCAN_MAX_RESULTS=300

# Live-Radar: Bereinigungs-Job (Positionen älter als 30 Min. werden
# physisch gelöscht - Datenschutz). Intervall in ms, Default 5 min.
RADAR_PRUNE_INTERVAL_MS=300000

# Ride-Relais (Live-Gruppenfahrt): Shared Secret. NUR das BFF darf
# ride_position/leave_ride senden (Frame muss das Secret mitbringen).
# Muss IDENTISCH mit RIDE_RELAY_SECRET im BFF sein; fehlt es hier,
# startet das Relais nicht (fail-closed).
RIDE_RELAY_SECRET=
