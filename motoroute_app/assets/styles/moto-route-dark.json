{
  "version": 8,
  "name": "moto-route-dark",
  "metadata": {
    "description": "MotoRoute dark map style - CARTO dark raster, komplett ohne API-Key/Account. Fuer einen eigenen Vektor-Stil MAP_STYLE_URL als dart-define setzen (siehe docs/API_SETUP.md)."
  },
  "sources": {
    "carto-dark": {
      "type": "raster",
      "tiles": [
        "https://a.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}@2x.png",
        "https://b.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}@2x.png",
        "https://c.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}@2x.png"
      ],
      "tileSize": 512,
      "maxzoom": 19,
      "attribution": "© OpenStreetMap-Mitwirkende, © CARTO"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#0B0E11"
      }
    },
    {
      "id": "carto-dark",
      "type": "raster",
      "source": "carto-dark",
      "paint": {
        "raster-opacity": 0.94,
        "raster-saturation": -0.2,
        "raster-contrast": 0.06
      }
    }
  ]
}
