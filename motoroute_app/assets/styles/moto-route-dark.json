{
  "version": 8,
  "name": "moto-route-dark",
  "metadata": {
    "description": "MotoRoute dark map style - cockpit aesthetic, route is the only loud element"
  },
  "glyphs": "https://fonts.openmaptiles.org/{fontstack}/{range}.pbf",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openmaptiles.org/v3/openmaptiles/tiles.json"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#0B0E11"
      }
    },
    {
      "id": "land",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "land",
      "paint": {
        "fill-color": "#151A1F"
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#1A2330"
      }
    },
    {
      "id": "road",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transport",
      "filter": [
        "all",
        ["!=", "class", "motorway"],
        ["!=", "class", "trunk"],
        ["!=", "class", "primary"]
      ],
      "paint": {
        "line-color": "#2A3340",
        "line-width": 1
      }
    },
    {
      "id": "road-secondary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transport",
      "filter": [
        "all",
        ["==", "class", "secondary"]
      ],
      "paint": {
        "line-color": "#3A4452",
        "line-width": 2
      }
    },
    {
      "id": "road-primary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transport",
      "filter": [
        "all",
        ["==", "class", "primary"]
      ],
      "paint": {
        "line-color": "#4A5563",
        "line-width": 3
      }
    },
    {
      "id": "road-trunk",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transport",
      "filter": [
        "all",
        ["==", "class", "trunk"]
      ],
      "paint": {
        "line-color": "#5A6573",
        "line-width": 4
      }
    },
    {
      "id": "road-motorway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transport",
      "filter": [
        "all",
        ["==", "class", "motorway"]
      ],
      "paint": {
        "line-color": "#FF5A1F",
        "line-width": 5,
        "line-opacity": 0.7
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "paint": {
        "fill-color": "#1A1F28"
      }
    },
    {
      "id": "poi",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "poi",
      "layout": {
        "visibility": "none"
      }
    }
  ]
}