# MotoRoute – Beispiel-Umgebungsvariablen (kopieren nach .env, Werte anpassen).
# KEINE echten Keys hier committen (docs/10-dev-process.md §2).

# Backend
MOTOROUTE_VALHALLA_URL=http://localhost:8002
MOTOROUTE_PHOTON_URL=http://localhost:2322
MOTOROUTE_OVERPASS_URL=https://overpass-api.de/api/interpreter
# Optional: aktiviert echte TomTom-Verkehrsmeldungen im Backend. Nie in Flutter/APK ablegen.
# MOTOROUTE_TOMTOM_API_KEY=
MOTOROUTE_RATE_LIMIT_PER_MINUTE=60
# MOTOROUTE_CLIENT_TOKEN=  # leer/auskommentiert = Dev-Modus ohne Token-Check

# Flutter-App (beim Build als --dart-define übergeben, siehe apps/mobile/lib/core/config/env.dart)
# MOTOROUTE_API_BASE_URL=http://10.0.2.2:8000
